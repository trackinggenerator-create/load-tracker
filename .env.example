# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase > Project Settings > API Keys). Never commit .env.local or paste keys into chat.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# The name customers see on tracking pages.
COMPANY_NAME=Werner Enterprises

# New accounts are off. Set to true only while adding a coworker, then remove it.
# ALLOW_SIGNUP=true

# Optional: only if Edge isn't at the usual place on this PC.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Set on the live site if you use your own domain (otherwise Vercel's address is used).
# NEXT_PUBLIC_SITE_URL=https://track.example.com
